# OOP Tutor — Production Nginx
# Replace tutor.cs.university.edu with your actual hostname

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name tutor.cs.university.edu;
    return 301 https://$host$request_uri;
}

# HTTPS — main server block
server {
    listen 443 ssl;
    server_name tutor.cs.university.edu;

    # SSL certificates
    # Option A: Let's Encrypt (certbot)
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    # Frontend — served by internal Nginx
    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # RAG backend — long timeout for LLM inference
    location /api/query {
        proxy_pass http://rag-backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
    }

    location /api/socratic {
        proxy_pass http://rag-backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
    }

    location /api/graph {
        proxy_pass http://rag-backend:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Assessment backend
    location /assessment/ {
        proxy_pass http://assessment:3002/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript;
    gzip_min_length 1000;
}
