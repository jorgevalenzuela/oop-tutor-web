# OOP Tutor Web — Production Environment
# Copy to .env.production and fill in values
# NEVER commit .env.production to git

# Anthropic API (for Socratic dialogue + AI grading)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Email (magic link auth + discussion notifications)
EMAIL_HOST=smtp.campus.university.edu
EMAIL_PORT=587
EMAIL_USER=oop-tutor@university.edu
EMAIL_PASS=your_email_password
EMAIL_FROM=OOP Tutor <oop-tutor@university.edu>

# Security
JWT_SECRET=generate_a_long_random_string_here
JWT_SECRET_DEV=dev_secret_not_for_production
